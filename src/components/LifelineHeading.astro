---
const { title } = Astro.props;
---

<div class="h-48 w-full overflow-hidden md:h-70 lg:h-94">
  <div
    class="border-sygreen bg-sygreen -z-10 flex h-40 scale-120 items-center justify-center rounded-b-[50%] border md:h-60 lg:h-80"
  >
    <h1 class="text-center text-[min(6vw,4rem)] font-bold text-white">
      The {title} Lifeline
    </h1>
  </div>
</div>
