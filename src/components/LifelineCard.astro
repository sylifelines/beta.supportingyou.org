---
import { Image } from "astro:assets";
const { item, index } = Astro.props;
const { id, image, title } = item.data;
const slide = "slide".concat(String(index));
---

<div class="shadow-syslate/20 flex flex-col rounded-b-2xl shadow-lg">
  <div id={slide} class="carousel-item relative mb-6 h-86 w-87">
    <Image
      src={image}
      alt={title}
      width={350}
      height={344}
      loading="lazy"
      class="h-[344px] w-[350px] rounded-2xl object-cover"
    />
  </div>
  <div class="mb-4 ml-2 text-2xl font-bold text-black">{title} Lifeline</div>
  <div class="mb-6 px-4">
    <a href={`/lifeline/${id}`}>
      <button
        type="button"
        class="bg-sygreen hover:bg-syblue focus-visible:outline-sygreen rounded-full px-3.5 py-2 text-sm font-semibold text-white shadow-xs hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2"
        >Discover more</button
      >
    </a>
  </div>
</div>
